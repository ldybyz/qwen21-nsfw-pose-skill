{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Anatomy Element",
  "description": "解剖/裸露程度要素 — 提示词七要素之 ⑥",
  "type": "object",
  "required": ["element", "id", "name_zh", "name_en", "prompt"],
  "properties": {
    "element": { "const": "anatomy" },
    "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "name_zh": { "type": "string" },
    "name_en": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "tier": { "type": "string", "enum": ["L0", "L1", "L2", "L3"], "description": "与 pose tier 对齐的裸露梯级" },
    "prompt": { "type": "string", "description": "解剖/裸露描述片段" }
  }
}
